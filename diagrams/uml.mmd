classDiagram
    class Owner {
        +str name
        +int available_minutes
        +int day_start_minute
        +Preferences preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(pet) None
        +get_all_tasks() list~Task~
        +filter_tasks(pet_name, completed) list~Task~
    }

    class Preferences {
        +int buffer_minutes
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
        +edit_task(task, **changes) None
        +remove_task(task) None
        +complete_task(task) Task
    }

    class Task {
        +str id
        +str title
        +int duration_minutes
        +Priority priority
        +Frequency frequency
        +bool completed
        +int preferred_time
        +date due_date
        +str pet_name
        +mark_complete() Task
        +priority_value() int
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Scheduler {
        +Owner owner
        +generate_plan(plan_date) DailyPlan
        +sort_by_time(tasks) list~Task~
        +detect_conflicts(plan_date) list~str~
        +explain_plan(plan) str
    }

    class DailyPlan {
        +list~ScheduledItem~ scheduled_items
        +list~SkippedItem~ skipped_items
        +int total_minutes
        +add_item(task, start_minute, reason) None
        +skip(task, reason) None
        +display() str
    }

    class ScheduledItem {
        +Task task
        +int start_minute
        +str reason
        +int end_minute
    }

    class SkippedItem {
        +Task task
        +str reason
    }

    Owner "1" *-- "0..*" Pet : has
    Owner *-- Preferences
    Pet "1" *-- "0..*" Task : has
    Task --> Priority
    Task --> Frequency
    Task ..> Pet : pet_name refers to
    Scheduler --> Owner : reads from
    Scheduler ..> DailyPlan : creates
    DailyPlan *-- "0..*" ScheduledItem
    DailyPlan *-- "0..*" SkippedItem
    ScheduledItem --> Task
    SkippedItem --> Task
