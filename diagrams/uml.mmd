classDiagram
    class Owner {
        +str name
        +int available_minutes
        +dict preferences
        +list~Pet~ pets
        +add_pet(pet) None
        +remove_pet(pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task) None
        +edit_task(task, **changes) None
        +remove_task(task) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +bool completed
        +str preferred_time
        +mark_complete() None
        +priority_value() int
    }

    class Scheduler {
        +Owner owner
        +generate_plan() DailyPlan
        +explain_plan(plan) str
    }

    class DailyPlan {
        +list scheduled_items
        +list skipped_tasks
        +int total_minutes
        +list~str~ reasoning
        +add_item(task, start_time) None
        +skip(task, reason) None
        +display() str
    }

    Owner "1" *-- "1..*" Pet : has
    Pet "1" *-- "0..*" Task : has
    Scheduler --> Owner : reads from
    Scheduler ..> DailyPlan : creates
    DailyPlan o-- "0..*" Task : schedules / skips
